+it('PipelineFactory does not alias compute pipelines that differ in entryPoint or constants', async () => {
+  const webgpuDevice = await getWebGPUTestDevice();
+  if (!webgpuDevice?.props._cachePipelines) {
+    return;
+  }
+
+  const pipelineFactory = new PipelineFactory(webgpuDevice);
+  const shader = webgpuDevice.createShader({
+    source: /* wgsl */ `
+override scale: f32 = 1.0;
+override bias: f32 = 0.0;
+@compute @workgroup_size(1) fn mainA() { _ = scale + bias; }
+@compute @workgroup_size(1) fn mainB() { _ = scale - bias; }
+`
+  });
+  const base: ComputePipelineProps = {shader, shaderLayout: {bindings: []}, entryPoint: 'mainA'};
+
+  try {
+    const a = pipelineFactory.createComputePipeline(base);
+    const sameKeyOrderSwapped = pipelineFactory.createComputePipeline({
+      ...base,
+      constants: {bias: 2, scale: 3}
+    });
+    const sameKeyOrder = pipelineFactory.createComputePipeline({
+      ...base,
+      constants: {scale: 3, bias: 2}
+    });
+    const otherEntry = pipelineFactory.createComputePipeline({...base, entryPoint: 'mainB'});
+    const otherConstants = pipelineFactory.createComputePipeline({
+      ...base,
+      constants: {scale: 4, bias: 2}
+    });
+
+    expect(sameKeyOrder).toBe(sameKeyOrderSwapped);
+    expect(a).not.toBe(sameKeyOrder);
+    expect(a).not.toBe(otherEntry);
+    expect(otherConstants).not.toBe(sameKeyOrder);
+  } finally {
+    shader.destroy();
+  }
+});
