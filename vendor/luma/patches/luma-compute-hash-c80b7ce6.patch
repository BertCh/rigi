--- a/modules/core/src/factories/pipeline-factory.ts
+++ b/modules/core/src/factories/pipeline-factory.ts
@@ -19,6 +19,18 @@ type PendingCacheItem<ResourceT extends Resource<any>> = {
   useCount: number;
 };
 
+/** Stable (key-sorted) serialization of pipeline override constants, for cache keys */
+function stableStringifyConstants(constants: Record<string, number> | undefined): string {
+  if (!constants) {
+    return '{}';
+  }
+  return JSON.stringify(
+    Object.keys(constants)
+      .sort()
+      .map(key => [key, constants[key]])
+  );
+}
+
 const asyncCompilationByDevice = new WeakMap<Device, Promise<unknown>[]>();
 
 /**
@@ -370,7 +382,12 @@ export class PipelineFactory {
     const {type} = this.device;
     const shaderHash = this._getHash(props.shader.source);
     const shaderLayoutHash = this._getHash(JSON.stringify(props.shaderLayout));
-    return `${type}/C/${shaderHash}SL${shaderLayoutHash}`;
+    // `entryPoint` and override `constants` change the created `GPUComputePipeline`, so two
+    // specs that differ only in these must not share a cached pipeline. Constants are
+    // serialized with sorted keys so equivalent objects hash identically.
+    const entryPointHash = this._getHash(String(props.entryPoint ?? ''));
+    const constantsHash = this._getHash(stableStringifyConstants(props.constants));
+    return `${type}/C/${shaderHash}EP${entryPointHash}K${constantsHash}SL${shaderLayoutHash}`;
   }
 
   /** Calculate a hash based on all the inputs for a render pipeline */
