 modules/gpgpu/src/gpu-core/gpu-fft-utils.ts     |  9 +++++----
 modules/gpgpu/src/gpu-core/gpu-fft1d.ts         | 17 ++++++++++++-----
 .../gpgpu/test/gpu-core/gpu-fft1d.node.spec.ts  | 17 ++++++++++++++---
