diff --git a/modules/core/src/adapter/resources/buffer.ts b/modules/core/src/adapter/resources/buffer.ts
index 987abdf38..36eefd7d9 100644
--- a/modules/core/src/adapter/resources/buffer.ts
+++ b/modules/core/src/adapter/resources/buffer.ts
@@ -17,6 +17,37 @@ export type BufferMapReadOptions = {
   waitForSubmittedWork?: boolean;
 };
 
+/** Options for Buffer.readAsync */
+export type BufferReadOptions = BufferMapReadOptions & {
+  /**
+   * Copy the bytes into this view (starting at its `byteOffset`) instead of into a new array.
+   * It must hold at least `byteLength` bytes. `readAsync` then resolves to a `Uint8Array` over
+   * exactly those bytes of `target`'s buffer (no further copy).
+   */
+  target?: ArrayBufferView<ArrayBuffer>;
+};
+
+/**
+ * The `Uint8Array` that a read of `byteLength` bytes writes into: `options.target` (checked to be
+ * large enough) or a new array.
+ * @internal for Buffer implementations
+ */
+export function getBufferReadTarget(
+  byteLength: number,
+  options?: BufferReadOptions
+): Uint8Array<ArrayBuffer> {
+  const target = options?.target;
+  if (!target) {
+    return new Uint8Array(byteLength);
+  }
+  if (target.byteLength < byteLength) {
+    throw new RangeError(
+      `Buffer.readAsync(): target holds ${target.byteLength} bytes, ${byteLength} requested`
+    );
+  }
+  return new Uint8Array(target.buffer, target.byteOffset, byteLength);
+}
+
 /** Callback for Buffer.mapAndReadAsync */
 export type BufferMapCallback<T> = (arrayBuffer: ArrayBuffer, lifetime: 'mapped' | 'copied') => T;
 
@@ -115,8 +146,15 @@ export abstract class Buffer extends Resource<BufferProps> {
     byteLength?: number
   ): Promise<void>;
 
-  /** Reads data asynchronously, returns a copy of the buffer data */
-  abstract readAsync(byteOffset?: number, byteLength?: number): Promise<Uint8Array>;
+  /**
+   * Reads data asynchronously, returns a copy of the buffer data
+   * (in `options.target` when given; see {@link BufferReadOptions})
+   */
+  abstract readAsync(
+    byteOffset?: number,
+    byteLength?: number,
+    options?: BufferReadOptions
+  ): Promise<Uint8Array>;
 
   /** Maps buffer data to CPU memory. Mapped memory is only accessible in the callback */
   abstract mapAndReadAsync<T>(
