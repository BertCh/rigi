diff --git a/modules/core/test/adapter/resources/buffer.spec.ts b/modules/core/test/adapter/resources/buffer.spec.ts
index 9d99c2eed..a9d79a9f9 100644
--- a/modules/core/test/adapter/resources/buffer.spec.ts
+++ b/modules/core/test/adapter/resources/buffer.spec.ts
@@ -798,3 +798,45 @@ it('Buffer#mapAndReadAsync (waitForSubmittedWork: false)', async () => {
     buffer.destroy();
   }
 });
+
+it('Buffer#readAsync into a caller-provided target', async () => {
+  for (const device of await getTestDevices(DEVICE_TYPES)) {
+    const initialData = new Float32Array([10, 20, 30, 40]);
+    const buffer = device.createBuffer({
+      data: initialData,
+      usage: Buffer.COPY_DST | Buffer.COPY_SRC
+    });
+
+    // full read into a Float32Array: the result views the target's memory, no new allocation
+    const target = new Float32Array(4);
+    const full = await buffer.readAsync(0, 16, {target});
+    expect(full.buffer, `${device.type} result views the target buffer`).toBe(target.buffer);
+    expect(full.byteLength, `${device.type} result length`).toBe(16);
+    expect(target, `${device.type} target holds the data`).toEqual(initialData);
+
+    // partial read into the middle of a larger target (honours the view's byteOffset)
+    const backing = new Uint8Array(32).fill(0xee);
+    const window = new Uint8Array(backing.buffer, 8, 12);
+    const partial = await buffer.readAsync(8, 8, {target: window});
+    expect(partial.byteOffset, `${device.type} result starts at the target offset`).toBe(8);
+    expect(new Float32Array(backing.buffer, 8, 2), `${device.type} partial bytes`).toEqual(
+      new Float32Array([30, 40])
+    );
+    expect(backing[7], `${device.type} bytes before the target untouched`).toBe(0xee);
+    expect(backing[16], `${device.type} bytes after the read untouched`).toBe(0xee);
+
+    // too small a target is rejected
+    await expect(
+      buffer.readAsync(0, 16, {target: new Uint8Array(8)}),
+      `${device.type} small target rejected`
+    ).rejects.toThrow(RangeError);
+
+    // without a target the result is still a fresh copy
+    const copy = await buffer.readAsync();
+    expect(new Float32Array(copy.buffer, copy.byteOffset, 4), `${device.type} copy`).toEqual(
+      initialData
+    );
+
+    buffer.destroy();
+  }
+});
