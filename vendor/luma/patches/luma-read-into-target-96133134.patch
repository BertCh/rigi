diff --git a/modules/test-utils/test/null-device/null-buffer-read-target.spec.ts b/modules/test-utils/test/null-device/null-buffer-read-target.spec.ts
new file mode 100644
index 000000000..7f9fe64fb
--- /dev/null
+++ b/modules/test-utils/test/null-device/null-buffer-read-target.spec.ts
@@ -0,0 +1,37 @@
+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {expect, test} from 'vitest';
+import {Buffer} from '@luma.gl/core';
+
+test('NullBuffer#readAsync reads into a caller-provided target', async () => {
+  const {NullDevice} = await import('../../src/index');
+  const device = new NullDevice({});
+  const buffer = device.createBuffer({
+    data: new Float32Array([1, 2, 3, 4]),
+    usage: Buffer.COPY_DST | Buffer.COPY_SRC
+  });
+
+  const target = new Float32Array(4);
+  const result = await buffer.readAsync(0, 16, {target});
+  expect(result.buffer).toBe(target.buffer);
+  expect(target).toEqual(new Float32Array([1, 2, 3, 4]));
+
+  const backing = new Uint8Array(24).fill(7);
+  const partial = await buffer.readAsync(4, 8, {target: new Uint8Array(backing.buffer, 12, 12)});
+  expect(partial.byteOffset).toBe(12);
+  expect(partial.byteLength).toBe(8);
+  expect(new Float32Array(backing.buffer, 12, 2)).toEqual(new Float32Array([2, 3]));
+  expect(backing[11]).toBe(7);
+  expect(backing[20]).toBe(7);
+
+  await expect(buffer.readAsync(0, 16, {target: new Uint8Array(4)})).rejects.toThrow(RangeError);
+
+  const copy = await buffer.readAsync();
+  expect(copy.buffer).not.toBe(target.buffer);
+  expect(new Float32Array(copy.buffer)).toEqual(new Float32Array([1, 2, 3, 4]));
+
+  buffer.destroy();
+  device.destroy();
+});
