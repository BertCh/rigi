+    let resolveFramebuffer = this._resolveFramebuffers.get(view);
+    if (!resolveFramebuffer) {
+      resolveFramebuffer = new WEBGLFramebuffer(this.device, {
+        id: `${this.id}-resolve-${this._resolveFramebuffers.size}`,
+        width: this.width,
+        height: this.height,
+        colorAttachments: aspect === 'color' ? [view] : [],
+        depthStencilAttachment: aspect === 'color' ? null : view
+      });
+      this._resolveFramebuffers.set(view, resolveFramebuffer);
+    }
+    return resolveFramebuffer;
   }
 
   // PRIVATE
