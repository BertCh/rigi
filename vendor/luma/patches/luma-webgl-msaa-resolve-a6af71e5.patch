index 000000000..e7f6b023b
--- /dev/null
+++ b/modules/webgl/src/adapter/helpers/webgl-resolve.ts
@@ -0,0 +1,53 @@
+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {GL} from '@luma.gl/webgl/constants';
+
+/** One blit of a multisample resolve: which buffer of the source goes into which framebuffer. */
+export type WebGLResolveBlit = {
+  /** Framebuffer holding the single-sample resolve target (bound as DRAW_FRAMEBUFFER). */
+  framebuffer: WebGLFramebuffer;
+  /** `GL.COLOR_BUFFER_BIT`, or `GL.DEPTH_BUFFER_BIT` and/or `GL.STENCIL_BUFFER_BIT`. */
+  mask: number;
+  /** Source color attachment index (read buffer), for a color blit. */
+  colorAttachment?: number;
+};
+
+/**
+ * Resolves a multisampled framebuffer into single-sample framebuffers with `blitFramebuffer`
+ * (WebGL2's only multisample resolve), one blit per target, over the full `width` x `height`
+ * (a multisample blit requires identical source and destination rectangles), `GL.NEAREST`.
+ * Blits are affected by the scissor test and rasterizer discard, so both are disabled for the
+ * duration; the caller restores bindings and enables (luma does it with the render pass state
+ * push/pop). `invalidateAttachments`: attachments of the source to invalidate afterwards (its
+ * multisample contents are not needed any more, so a tiled GPU can skip storing them).
+ */
+export function resolveMultisampleFramebufferWebGL(
+  gl: WebGL2RenderingContext,
+  source: WebGLFramebuffer,
+  width: number,
+  height: number,
+  blits: readonly WebGLResolveBlit[],
+  invalidateAttachments: readonly number[] = []
+): void {
+  gl.disable(GL.SCISSOR_TEST);
+  gl.disable(GL.RASTERIZER_DISCARD);
+  gl.bindFramebuffer(GL.READ_FRAMEBUFFER, source);
+  let readBufferChanged = false;
+  for (const blit of blits) {
+    if (blit.colorAttachment !== undefined) {
+      gl.readBuffer(GL.COLOR_ATTACHMENT0 + blit.colorAttachment);
+      readBufferChanged ||= blit.colorAttachment !== 0;
+    }
+    gl.bindFramebuffer(GL.DRAW_FRAMEBUFFER, blit.framebuffer);
+    gl.blitFramebuffer(0, 0, width, height, 0, 0, width, height, blit.mask, GL.NEAREST);
+  }
+  if (readBufferChanged) {
+    // the read buffer is framebuffer state: leave the source with its default
+    gl.readBuffer(GL.COLOR_ATTACHMENT0);
+  }
+  if (invalidateAttachments.length > 0) {
+    gl.invalidateFramebuffer(GL.READ_FRAMEBUFFER, invalidateAttachments as number[]);
+  }
+}
