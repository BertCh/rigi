   vertexShader.destroy();
   fragmentShader.destroy();
 });
+
+it('WEBGLRenderPass resolves multisampled attachments into resolveTargets', async () => {
+  const device = await getWebGLTestDevice();
+  const {gl} = device;
+  const samples = Math.min(4, gl.getParameter(GL.MAX_SAMPLES) as number);
+  if (samples < 2) {
+    return;
+  }
+
+  const msColor = device.createTexture({format: 'rgba8unorm', width: 4, height: 4, samples});
+  const msDepth = device.createTexture({format: 'depth24plus', width: 4, height: 4, samples});
+  expect(msColor.samples, 'multisampled texture keeps its sample count').toBe(samples);
+  expect(gl.isRenderbuffer(msColor.handle), 'backed by a multisample renderbuffer').toBe(true);
+  const multisampled = device.createFramebuffer({
+    width: 4,
+    height: 4,
+    colorAttachments: [msColor],
+    depthStencilAttachment: msDepth
+  });
+  const resolved = device.createFramebuffer({
+    width: 4,
+    height: 4,
+    colorAttachments: ['rgba8unorm'],
+    depthStencilAttachment: 'depth24plus'
+  });
+
+  // clear the multisampled attachments, resolve them at end(), then read the single-sample target
+  device
+    .beginRenderPass({
+      framebuffer: multisampled,
+      clearColor: [1, 0, 0, 1],
+      clearDepth: 0.25,
+      resolveTargets: [resolved.colorAttachments[0]],
+      depthStencilResolveTarget: resolved.depthStencilAttachment
+    })
+    .end();
+  expect(gl.getError(), 'resolve blits raise no GL error').toBe(GL.NO_ERROR);
+  const pixel = device.readPixelsToArrayWebGL(resolved, {sourceWidth: 1, sourceHeight: 1});
+  expect(Array.from(pixel), 'color resolved into the target').toEqual([255, 0, 0, 255]);
+
+  // a resolve-only pass (load, discard): resolves again and invalidates the multisample storage
+  const invalidated: number[][] = [];
+  const originalInvalidate = gl.invalidateFramebuffer.bind(gl);
+  gl.invalidateFramebuffer = ((target: number, attachments: number[]) => {
+    invalidated.push([...attachments]);
+    return originalInvalidate(target, attachments);
+  }) as typeof gl.invalidateFramebuffer;
+  try {
+    device
+      .beginRenderPass({
+        framebuffer: multisampled,
+        clearColor: false,
+        clearDepth: false,
+        clearStencil: false,
+        discard: true,
+        resolveTargets: [resolved.colorAttachments[0]]
+      })
+      .end();
+  } finally {
+    gl.invalidateFramebuffer = originalInvalidate;
+  }
+  expect(invalidated, 'discard invalidates every multisample attachment').toEqual([
+    [GL.COLOR_ATTACHMENT0, GL.DEPTH_ATTACHMENT]
+  ]);
+  expect(gl.getError(), 'resolve-only pass raises no GL error').toBe(GL.NO_ERROR);
+
+  expect(
+    () => device.createTexture({format: 'rgba8unorm', width: 4, height: 4, samples, mipLevels: 2}),
+    'multisampled textures have one mip level'
+  ).toThrow(/multisampled/);
+
+  multisampled.destroy();
+  resolved.destroy();
+  msColor.destroy();
