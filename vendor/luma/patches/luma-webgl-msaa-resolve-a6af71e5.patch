@@ -0,0 +1,77 @@
+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {GL} from '@luma.gl/webgl/constants';
+import {expect, it} from 'vitest';
+import {resolveMultisampleFramebufferWebGL} from '../../../src/adapter/helpers/webgl-resolve';
+
+/** A WebGL2 context stand-in that records the calls the resolve makes. */
+function makeRecordingContext() {
+  const calls: unknown[][] = [];
+  const record =
+    (name: string) =>
+    (...args: unknown[]) => {
+      calls.push([name, ...args]);
+    };
+  const gl = {
+    disable: record('disable'),
+    bindFramebuffer: record('bindFramebuffer'),
+    readBuffer: record('readBuffer'),
+    blitFramebuffer: record('blitFramebuffer'),
+    invalidateFramebuffer: record('invalidateFramebuffer')
+  } as unknown as WebGL2RenderingContext;
+  return {gl, calls};
+}
+
+it('resolveMultisampleFramebufferWebGL blits color and depth like the hand-written resolve', () => {
+  const {gl, calls} = makeRecordingContext();
+  const source = {name: 'ms'} as unknown as WebGLFramebuffer;
+  const colorTarget = {name: 'color'} as unknown as WebGLFramebuffer;
+  const depthTarget = {name: 'depth'} as unknown as WebGLFramebuffer;
+
+  resolveMultisampleFramebufferWebGL(
+    gl,
+    source,
+    640,
+    480,
+    [
+      {framebuffer: colorTarget, mask: GL.COLOR_BUFFER_BIT, colorAttachment: 0},
+      {framebuffer: depthTarget, mask: GL.DEPTH_BUFFER_BIT}
+    ],
+    [GL.COLOR_ATTACHMENT0, GL.DEPTH_ATTACHMENT]
+  );
+
+  expect(calls).toEqual([
+    ['disable', GL.SCISSOR_TEST],
+    ['disable', GL.RASTERIZER_DISCARD],
+    ['bindFramebuffer', GL.READ_FRAMEBUFFER, source],
+    ['readBuffer', GL.COLOR_ATTACHMENT0],
+    ['bindFramebuffer', GL.DRAW_FRAMEBUFFER, colorTarget],
+    ['blitFramebuffer', 0, 0, 640, 480, 0, 0, 640, 480, GL.COLOR_BUFFER_BIT, GL.NEAREST],
+    ['bindFramebuffer', GL.DRAW_FRAMEBUFFER, depthTarget],
+    ['blitFramebuffer', 0, 0, 640, 480, 0, 0, 640, 480, GL.DEPTH_BUFFER_BIT, GL.NEAREST],
+    ['invalidateFramebuffer', GL.READ_FRAMEBUFFER, [GL.COLOR_ATTACHMENT0, GL.DEPTH_ATTACHMENT]]
+  ]);
+});
+
+it('resolveMultisampleFramebufferWebGL restores the read buffer after a non-zero attachment', () => {
+  const {gl, calls} = makeRecordingContext();
+  const source = {} as WebGLFramebuffer;
+  const target = {} as WebGLFramebuffer;
+  resolveMultisampleFramebufferWebGL(gl, source, 2, 2, [
+    {framebuffer: target, mask: GL.COLOR_BUFFER_BIT, colorAttachment: 1}
+  ]);
+  const names = calls.map(call => call[0]);
+  expect(names).toEqual([
+    'disable',
+    'disable',
+    'bindFramebuffer',
+    'readBuffer',
+    'bindFramebuffer',
+    'blitFramebuffer',
+    'readBuffer'
+  ]);
+  expect(calls[3]).toEqual(['readBuffer', GL.COLOR_ATTACHMENT0 + 1]);
+  expect(calls[6]).toEqual(['readBuffer', GL.COLOR_ATTACHMENT0]);
+});
