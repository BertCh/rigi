@@ -306,6 +310,69 @@ export class WEBGLRenderPass extends RenderPass {
 
   // PRIVATE
 
+  /**
+   * Resolves the multisampled attachments into `resolveTargets` / `depthStencilResolveTarget`
+   * (blitFramebuffer; WebGPU resolves natively at the end of the pass). Runs inside the pass's
+   * pushed GL state, so the bindings and enables it changes are restored by popState().
+   * With `discard` the multisample attachments are invalidated afterwards (cf. WebGPU storeOp 'discard').
+   */
+  protected _resolveAttachments(): void {
+    const framebuffer = this.props.framebuffer as WEBGLFramebuffer | null;
+    const resolveTargets = (this.props.resolveTargets || []) as (WEBGLTextureView | null)[];
+    const depthStencilResolveTarget = this.props
+      .depthStencilResolveTarget as WEBGLTextureView | null;
+    if (!framebuffer?.handle || (!resolveTargets.some(Boolean) && !depthStencilResolveTarget)) {
+      return;
+    }
+
+    const blits: WebGLResolveBlit[] = [];
+    resolveTargets.forEach((resolveTarget, colorAttachment) => {
+      if (resolveTarget && framebuffer.colorAttachments[colorAttachment]) {
+        blits.push({
+          framebuffer: framebuffer._getResolveFramebuffer(resolveTarget, 'color').handle,
+          mask: GL.COLOR_BUFFER_BIT,
+          colorAttachment
+        });
+      }
+    });
+    const depthStencilAttachment = framebuffer.depthStencilAttachment;
+    if (depthStencilResolveTarget && depthStencilAttachment) {
+      const attachmentPoint = getDepthStencilAttachmentWebGL(depthStencilAttachment.texture.format);
+      const mask =
+        attachmentPoint === GL.DEPTH_ATTACHMENT
+          ? GL.DEPTH_BUFFER_BIT
+          : attachmentPoint === GL.STENCIL_ATTACHMENT
+            ? GL.STENCIL_BUFFER_BIT
+            : GL.DEPTH_BUFFER_BIT | GL.STENCIL_BUFFER_BIT;
+      blits.push({
+        framebuffer: framebuffer._getResolveFramebuffer(depthStencilResolveTarget, 'depth-stencil')
+          .handle,
+        mask
+      });
+    }
+
+    const invalidateAttachments: number[] = [];
+    if (this.props.discard) {
+      framebuffer.colorAttachments.forEach((_, i) =>
+        invalidateAttachments.push(GL.COLOR_ATTACHMENT0 + i)
+      );
+      if (depthStencilAttachment) {
+        invalidateAttachments.push(
+          getDepthStencilAttachmentWebGL(depthStencilAttachment.texture.format)
+        );
+      }
+    }
+
+    resolveMultisampleFramebufferWebGL(
+      this.device.gl,
+      framebuffer.handle,
+      framebuffer.width,
+      framebuffer.height,
+      blits,
+      invalidateAttachments
+    );
+  }
+
   /**
    * Optionally clears depth, color and stencil buffers based on parameters
    */
