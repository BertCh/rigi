+    view: WEBGLTextureView,
+    aspect: 'color' | 'depth-stencil'
+  ): WEBGLFramebuffer {
+    for (const [resolveView, resolveFramebuffer] of this._resolveFramebuffers) {
+      if (resolveView.texture.destroyed) {
+        resolveFramebuffer.destroy();
+        this._resolveFramebuffers.delete(resolveView);
+      }
