+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {Buffer, type Device} from '@luma.gl/core';
+import {GPUReadbackRing} from '@luma.gl/gpgpu/gpu-core';
+import {getNullTestDevice} from '@luma.gl/test-utils';
+import {describe, expect, test} from 'vitest';
+
+function makeSource(device: Device, words: number[]): Buffer {
+  return device.createBuffer({
+    data: new Uint32Array(words),
+    usage: Buffer.COPY_SRC | Buffer.COPY_DST
+  });
+}
+
+describe('GPUReadbackRing growable slots', () => {
+  test('fixed rings reject requests above their slot size', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 1});
+    expect(() => ring.tryAcquire({byteLength: 32})).toThrow(/growable/);
+    expect(ring.tryAcquire({byteLength: 8})).not.toBe(null);
+    ring.destroy();
+  });
+
+  test('growable rings replace an idle slot that is too small, then reuse it', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 2, growable: true});
+    const small = ring.tryAcquire({byteLength: 8})!;
+    const smallBuffer = small.buffer;
+    expect(smallBuffer.byteLength).toBe(16);
+    small.cancel();
+
+    const big = ring.tryAcquire({byteLength: 100})!;
+    expect(big.buffer.byteLength, 'grown to a power of two').toBe(128);
+    const source = makeSource(
+      device,
+      Array.from({length: 25}, (_, index) => index)
+    );
+    const encoder = device.createCommandEncoder();
+    big.copyFrom(encoder, source, {byteLength: 100});
+    device.submit(encoder.finish());
+    const bytes = await big.read();
+    expect(Array.from(new Uint32Array(bytes.buffer, bytes.byteOffset, 25))).toEqual(
+      Array.from({length: 25}, (_, index) => index)
+    );
+
+    const again = ring.tryAcquire({byteLength: 100})!;
+    expect(again.buffer.byteLength, 'the grown slot is reused without a new allocation').toBe(128);
+    again.cancel();
+    source.destroy();
+    ring.destroy();
+  });
+
+  test('a waiter is served with a slot large enough for its request', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 1, growable: true});
+    const held = ring.tryAcquire()!;
+    const waiting = ring.acquire({byteLength: 64});
+    held.cancel();
+    const ticket = await waiting;
+    expect(ticket.buffer.byteLength).toBe(64);
+    ticket.cancel();
+    ring.destroy();
+  });
+});
+
+describe('GPUReadbackTicket.readPartial', () => {
+  test('maps the header, then only the used prefix', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 64, slotCount: 1});
+    // header word = number of used words after it; the tail past the used words is garbage
+    const words = [3, 11, 22, 33, 0xdead, 0xdead, 0xdead, 0xdead];
+    const source = makeSource(device, words);
+    const ticket = ring.tryAcquire()!;
+    const encoder = device.createCommandEncoder();
+    ticket.copyFrom(encoder, source, {byteLength: 32});
+    device.submit(encoder.finish());
+    const {header, data} = await ticket.readPartial({
+      headerByteLength: 4,
+      getByteLength: headerBytes => 4 + new Uint32Array(headerBytes.buffer)[0] * 4
+    });
+    expect(new Uint32Array(header.buffer, header.byteOffset, 1)[0]).toBe(3);
+    expect(Array.from(new Uint32Array(data.buffer, data.byteOffset, data.byteLength / 4))).toEqual([
+      3, 11, 22, 33
+    ]);
+    expect(ring.availableSlotCount, 'the slot is released after the read').toBe(1);
+    source.destroy();
+    ring.destroy();
+  });
+
+  test('rejects a length outside the encoded range and still releases the slot', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 1});
+    const source = makeSource(device, [1, 2, 3, 4]);
+    const ticket = ring.tryAcquire()!;
+    const encoder = device.createCommandEncoder();
+    ticket.copyFrom(encoder, source);
+    device.submit(encoder.finish());
+    await expect(
+      ticket.readPartial({headerByteLength: 4, getByteLength: () => 64})
+    ).rejects.toThrow(/partial length/);
+    expect(ring.availableSlotCount).toBe(1);
+    source.destroy();
+    ring.destroy();
+  });
+
+  test('requires an encoded ticket', async () => {
+    const device = await getNullTestDevice();
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 1});
+    const ticket = ring.tryAcquire()!;
+    await expect(ticket.readPartial({headerByteLength: 4, getByteLength: () => 4})).rejects.toThrow(
+      /encoded/
+    );
+    ticket.cancel();
+    ring.destroy();
+  });
+});
