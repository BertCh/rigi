@@ -97,6 +120,58 @@ export class GPUReadbackTicket {
     }
   }
 
+  /**
+   * Like `read()`, but maps only the used prefix of a capacity-sized copy.
+   *
+   * The header (the first `headerByteLength` bytes of the encoded range) is mapped first;
+   * `getByteLength(header)` then says how many bytes of the range hold data (an integer from the
+   * header length through the encoded length), and only those are mapped and returned. Bytes
+   * past the used length are copied on the GPU but never mapped. Resolves the header and the
+   * data (which starts with the header).
+   */
+  async readPartial(
+    options: GPUReadbackPartialOptions
+  ): Promise<{header: Uint8Array; data: Uint8Array}> {
+    if (this.state !== 'encoded') {
+      throw new Error('GPU readback ticket must be encoded before reading');
+    }
+    const {headerByteLength, getByteLength} = options;
+    if (
+      !Number.isSafeInteger(headerByteLength) ||
+      headerByteLength <= 0 ||
+      headerByteLength > this.copiedByteLength
+    ) {
+      throw new Error('GPU readback header must be positive and within the encoded range');
+    }
+    this.state = 'reading';
+    try {
+      const header = (
+        await this.buffer.readAsync(this.copiedByteOffset, alignUp(headerByteLength))
+      ).slice(0, headerByteLength);
+      const byteLength = getByteLength(header.slice());
+      if (
+        !Number.isSafeInteger(byteLength) ||
+        byteLength < headerByteLength ||
+        byteLength > this.copiedByteLength
+      ) {
+        throw new Error('GPU readback partial length must be an integer within the encoded range');
+      }
+      const data =
+        byteLength === headerByteLength
+          ? header
+          : (await this.buffer.readAsync(this.copiedByteOffset, alignUp(byteLength))).slice(
+              0,
+              byteLength
+            );
+      if (this.cancelled) {
+        throw new Error('GPU readback ticket was cancelled');
+      }
+      return {header, data};
+    } finally {
+      this.release();
+    }
+  }
+
   /**
    * Cancels an unused reservation, or discards a read already in progress.
    *
