-  /** Reserves a slot immediately, or returns `null` when the ring is under backpressure. */
-  tryAcquire(): GPUReadbackTicket | null {
+  /**
+   * Reserves a slot immediately, or returns `null` when the ring is under backpressure.
+   *
+   * With `growable`, the smallest idle slot that holds `options.byteLength` is used, or an idle
+   * slot is replaced by a larger one when none does.
+   */
+  tryAcquire(options: GPUReadbackAcquireOptions = {}): GPUReadbackTicket | null {
     if (this.destroyed) {
       return null;
     }
-    const buffer = this.availableBuffers.shift();
+    const byteLength = this.getRequestedByteLength(options);
+    const buffer = this.takeAvailableBuffer(byteLength);
     return buffer ? new GPUReadbackTicket(this, buffer) : null;
   }
 
   /** Waits for and reserves the next available slot. */
-  acquire(): Promise<GPUReadbackTicket> {
-    const ticket = this.tryAcquire();
+  acquire(options: GPUReadbackAcquireOptions = {}): Promise<GPUReadbackTicket> {
+    const ticket = this.tryAcquire(options);
     if (ticket) {
       return Promise.resolve(ticket);
     }
     if (this.destroyed) {
       return Promise.reject(new Error('GPUReadbackRing has been destroyed'));
     }
-    return new Promise((resolve, reject) => this.waiters.push({resolve, reject}));
+    const byteLength = this.getRequestedByteLength(options);
+    return new Promise((resolve, reject) => this.waiters.push({byteLength, resolve, reject}));
   }
 
   /** Rejects pending waiters and destroys idle slots; active slots are destroyed on release. */
@@ -220,11 +305,71 @@ export class GPUReadbackRing {
     }
     const waiter = this.waiters.shift();
     if (waiter) {
-      waiter.resolve(new GPUReadbackTicket(this, buffer));
+      waiter.resolve(new GPUReadbackTicket(this, this.fitBuffer(buffer, waiter.byteLength)));
     } else {
       this.availableBuffers.push(buffer);
     }
   }
+
+  private createSlotBuffer(byteLength: number): Buffer {
+    return this.device.createBuffer({
+      id: `${this.id}-slot-${this.nextSlotIndex++}`,
+      byteLength,
+      usage: Buffer.COPY_DST | Buffer.MAP_READ
+    });
+  }
+
+  private getRequestedByteLength(options: GPUReadbackAcquireOptions): number {
+    const byteLength = options.byteLength ?? this.byteLength;
+    validateAlignedRange(Number.MAX_SAFE_INTEGER, 0, byteLength, 'acquire');
+    if (byteLength > this.byteLength && !this.growable) {
+      throw new Error(
+        `GPUReadbackRing slots hold ${this.byteLength} bytes; create the ring with growable: true to request ${byteLength}`
+      );
+    }
+    return byteLength;
+  }
+
+  /** Removes the smallest idle slot that holds `byteLength` (growing the smallest if needed). */
+  private takeAvailableBuffer(byteLength: number): Buffer | undefined {
+    let best = -1;
+    for (const [index, buffer] of this.availableBuffers.entries()) {
+      if (
+        buffer.byteLength >= byteLength &&
+        (best < 0 || buffer.byteLength < this.availableBuffers[best].byteLength)
+      ) {
+        best = index;
+      }
+    }
+    if (best < 0 && this.growable && this.availableBuffers.length > 0) {
+      best = 0;
+      for (const [index, buffer] of this.availableBuffers.entries()) {
+        if (buffer.byteLength < this.availableBuffers[best].byteLength) best = index;
+      }
+    }
+    if (best < 0) {
+      return undefined;
+    }
+    const [buffer] = this.availableBuffers.splice(best, 1);
+    return this.fitBuffer(buffer, byteLength);
+  }
+
+  /** Returns `buffer`, or a larger replacement (destroying `buffer`) when it is too small. */
+  private fitBuffer(buffer: Buffer, byteLength: number): Buffer {
+    if (buffer.byteLength >= byteLength) {
+      return buffer;
+    }
+    buffer.destroy();
+    return this.createSlotBuffer(getNextPowerOfTwo(byteLength));
+  }
+}
+
+function alignUp(byteLength: number): number {
+  return Math.ceil(byteLength / 4) * 4;
+}
+
+function getNextPowerOfTwo(value: number): number {
+  return 2 ** Math.ceil(Math.log2(value));
 }
 
