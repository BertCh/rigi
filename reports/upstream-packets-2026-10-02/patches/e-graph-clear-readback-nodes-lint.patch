+/** A graph-owned transient buffer that a node reads before any scheduled node wrote it. */
+export type GPUCommandGraphUninitializedTransientRead = Readonly<{
+  /** Logical transient buffer id. */
+  bufferId: string;
+  /** Id of the first node that reads the buffer without an earlier write. */
+  nodeId: string;
+  /** The read access declared by that node. */
+  usage: GraphBufferUsage;
+}>;
+
 /** Aggregated static workload bounds available before the graph is submitted. */
 export type GPUCommandGraphPreflightReport = {
   readonly nodes: readonly GPUCommandGraphNodePreflight[];
+  /**
+   * Transient buffers whose first scheduled access is a read. Transients are not zero-initialized
+   * and may share bytes with other transients, so such a read observes undefined contents. Writes
+   * are tracked per buffer, not per byte range: a buffer counts as initialized once any node
+   * writes it, so partial writes (for example atomic accumulators) still need an explicit clear.
+   */
+  readonly uninitializedTransientReads: readonly GPUCommandGraphUninitializedTransientRead[];
   /** Number of scheduled nodes that supplied a workload estimate. */
   readonly annotatedNodeCount: number;
   /** Number of nodes carrying CPU or GPU conditional-execution metadata. */
