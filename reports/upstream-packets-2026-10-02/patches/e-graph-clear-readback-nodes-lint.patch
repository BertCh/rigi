+/**
+ * Finds transient buffers whose first scheduled access is a pure read (the node declares no write
+ * of that buffer before or alongside it). `storage-read-write` counts as a write.
+ * @internal
+ */
+export function getUninitializedTransientReads<Parameters>(
+  nodes: readonly GPUCommandGraphNode<Parameters>[]
+): GPUCommandGraphUninitializedTransientRead[] {
+  const written = new Set<GraphBufferHandle>();
+  const reported = new Set<GraphBufferHandle>();
+  const findings: GPUCommandGraphUninitializedTransientRead[] = [];
+  for (const node of nodes) {
+    const nodeWrites: GraphBufferHandle[] = [];
+    for (const resource of node.resources ?? []) {
+      if (!isGraphBufferUse(resource)) {
+        continue;
+      }
+      const handle = getBufferHandle(resource.buffer);
+      if (!handle.transient) {
+        continue;
+      }
+      if (isBufferWriteUsage(resource.usage)) {
+        nodeWrites.push(handle);
+      } else if (!written.has(handle) && !reported.has(handle)) {
+        reported.add(handle);
+        findings.push({bufferId: handle.id, nodeId: node.id, usage: resource.usage});
+      }
+    }
+    for (const handle of nodeWrites) {
+      written.add(handle);
+    }
+  }
+  return findings;
+}
+
 /** Returns the underlying logical buffer for either a handle or typed data view. @internal */
 export function getBufferHandle(buffer: GraphBufferHandle | GraphDataView): GraphBufferHandle {
   return 'buffer' in buffer ? buffer.buffer : buffer;
