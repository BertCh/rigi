diff --git a/modules/gpgpu/test/gpu-core/gpu-buffer-command-nodes.node.spec.ts b/modules/gpgpu/test/gpu-core/gpu-buffer-command-nodes.node.spec.ts
new file mode 100644
index 000000000..ea91832dd
--- /dev/null
+++ b/modules/gpgpu/test/gpu-core/gpu-buffer-command-nodes.node.spec.ts
@@ -0,0 +1,137 @@
+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {Buffer} from '@luma.gl/core';
+import {
+  createGPUClearBufferCommandNode,
+  createGPUReadbackCommandNode,
+  GPUCommandGraph,
+  GPUReadbackRing
+} from '@luma.gl/gpgpu/gpu-core';
+import {NullDevice} from '@luma.gl/test-utils';
+import {describe, expect, test} from 'vitest';
+
+describe('GPU buffer command nodes', () => {
+  test('clear node zeroes the requested range of an imported buffer', async () => {
+    const device = getWebGPULookalikeDevice();
+    const buffer = device.createBuffer({
+      data: new Uint32Array([1, 2, 3, 4]),
+      usage: Buffer.COPY_SRC | Buffer.COPY_DST
+    });
+    const graph = new GPUCommandGraph(device, {id: 'clear'});
+    const handle = graph.importBuffer(
+      {id: 'target', byteLength: buffer.byteLength, usage: buffer.usage},
+      buffer
+    );
+    graph.add(
+      createGPUClearBufferCommandNode({id: 'zero', target: handle, byteOffset: 4, byteLength: 8})
+    );
+    const compiled = graph.compile();
+    const encoder = device.createCommandEncoder();
+    compiled.encode(encoder, {parameters: undefined});
+    device.submit(encoder.finish());
+    const bytes = await buffer.readAsync();
+    expect(Array.from(new Uint32Array(bytes.buffer, bytes.byteOffset, 4))).toEqual([1, 0, 0, 4]);
+    compiled.destroy();
+    buffer.destroy();
+  });
+
+  test('readback node reads a transient at its place in the schedule', async () => {
+    const device = getWebGPULookalikeDevice();
+    const source = device.createBuffer({
+      data: new Uint32Array([7, 8, 9, 10]),
+      usage: Buffer.COPY_SRC | Buffer.COPY_DST
+    });
+    const graph = new GPUCommandGraph(device, {id: 'read'});
+    const imported = graph.importBuffer(
+      {id: 'source', byteLength: 16, usage: source.usage},
+      source
+    );
+    const transient = graph.createTransientBuffer({
+      id: 'scratch',
+      byteLength: 16,
+      usage: Buffer.COPY_SRC | Buffer.COPY_DST
+    });
+    const ring = new GPUReadbackRing(device, {byteLength: 16, slotCount: 1});
+    const ticket = ring.tryAcquire()!;
+    graph.addCopyPass({
+      id: 'fill',
+      resources: [
+        {buffer: imported, usage: 'copy-source'},
+        {buffer: transient, usage: 'copy-destination'}
+      ],
+      compile: () => ({
+        encode: ({commandEncoder, getBuffer}) =>
+          commandEncoder.copyBufferToBuffer({
+            sourceBuffer: getBuffer(imported),
+            destinationBuffer: getBuffer(transient),
+            size: 16
+          })
+      })
+    });
+    graph.add(
+      createGPUReadbackCommandNode({id: 'read', source: transient, getTicket: () => ticket})
+    );
+    const compiled = graph.compile();
+    expect(compiled.preflight.uninitializedTransientReads).toEqual([]);
+    const encoder = device.createCommandEncoder();
+    compiled.encode(encoder, {parameters: undefined});
+    device.submit(encoder.finish());
+    const bytes = await ticket.read();
+    expect(Array.from(new Uint32Array(bytes.buffer, bytes.byteOffset, 4))).toEqual([7, 8, 9, 10]);
+    compiled.destroy();
+    ring.destroy();
+    source.destroy();
+  });
+
+  test('byte ranges must be aligned and in bounds', async () => {
+    const device = getWebGPULookalikeDevice();
+    const graph = new GPUCommandGraph(device, {id: 'range'});
+    const handle = graph.createTransientBuffer({
+      id: 'scratch',
+      byteLength: 16,
+      usage: Buffer.COPY_DST
+    });
+    expect(() => createGPUClearBufferCommandNode({id: 'a', target: handle, byteOffset: 2})).toThrow(
+      /four-byte aligned/
+    );
+    expect(() =>
+      createGPUClearBufferCommandNode({id: 'b', target: handle, byteLength: 32})
+    ).toThrow(/in bounds/);
+  });
+});
+
+describe('uninitialized transient reads (preflight)', () => {
+  test('flags a transient read before any write, accepts a clear first', async () => {
+    const device = getWebGPULookalikeDevice();
+    for (const clearFirst of [false, true]) {
+      const graph = new GPUCommandGraph(device, {id: `lint-${clearFirst}`});
+      const transient = graph.createTransientBuffer({
+        id: 'accumulator',
+        byteLength: 16,
+        usage: Buffer.COPY_SRC | Buffer.COPY_DST
+      });
+      if (clearFirst) {
+        graph.add(createGPUClearBufferCommandNode({id: 'zero', target: transient}));
+      }
+      graph.addCopyPass({
+        id: 'consume',
+        resources: [{buffer: transient, usage: 'copy-source'}],
+        compile: () => ({encode: () => {}})
+      });
+      const compiled = graph.compile();
+      expect(compiled.preflight.uninitializedTransientReads).toEqual(
+        clearFirst ? [] : [{bufferId: 'accumulator', nodeId: 'consume', usage: 'copy-source'}]
+      );
+      compiled.destroy();
+    }
+  });
+});
+
+/** GPUCommandGraph only needs a `webgpu` device type to build and encode copy nodes. */
+function getWebGPULookalikeDevice(): NullDevice {
+  const device = new NullDevice({id: 'buffer-command-nodes-device'});
+  Object.defineProperty(device, 'type', {value: 'webgpu'});
+  return device;
+}
