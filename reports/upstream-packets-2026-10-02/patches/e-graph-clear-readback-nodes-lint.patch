+// luma.gl
+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: Copyright (c) vis.gl contributors
+
+import {createGPUCopyCommandNode, type GPUCopyCommandNode} from './gpu-command-node';
+import {GraphDataView, type GraphBufferHandle} from './gpu-command-graph-types';
+import type {GPUReadbackTicket} from './gpu-readback-ring';
+
+/** Byte range of a graph buffer or data view. */
+type GraphByteRange = {byteOffset: number; byteLength: number};
+
+/** Properties for {@link createGPUClearBufferCommandNode}. */
+export type GPUClearBufferCommandNodeProps = {
+  /** Node id, unique within the graph. */
+  id: string;
+  /** Whole buffer, or the contiguous byte span covered by a data view. */
+  target: GraphBufferHandle | GraphDataView;
+  /** Start of the cleared range, relative to `target`. Defaults to `0`. Multiple of four. */
+  byteOffset?: number;
+  /** Length of the cleared range. Defaults to the rest of `target`. Multiple of four. */
+  byteLength?: number;
+  /** Ids of nodes that must be scheduled before this one. */
+  dependsOn?: string[];
+};
+
+/**
+ * Creates a copy-pass node that zeroes a graph buffer range with `CommandEncoder.clearBuffer()`.
+ *
+ * Transient buffers are not initialized, and compatible transients with disjoint lifetimes alias
+ * the same bytes, so an operation that accumulates into a transient (atomics, partial writes)
+ * must be preceded by a clear. The node declares `copy-destination` use, so graph hazard
+ * inference orders it before every later use of the range.
+ */
+export function createGPUClearBufferCommandNode<Parameters = void>(
+  props: GPUClearBufferCommandNodeProps
+): GPUCopyCommandNode<Parameters> {
+  const range = getGraphByteRange(props.target, props.byteOffset, props.byteLength, 'clear');
+  return createGPUCopyCommandNode<Parameters>({
+    id: props.id,
+    dependsOn: props.dependsOn,
+    resources: [{buffer: props.target, usage: 'copy-destination'}],
+    compile: () => ({
+      encode: ({commandEncoder, getBuffer}) => {
+        if (range.byteLength > 0) {
+          commandEncoder.clearBuffer(getBuffer(props.target), range.byteOffset, range.byteLength);
+        }
+      }
+    })
+  });
+}
+
+/** Properties for {@link createGPUReadbackCommandNode}. */
+export type GPUReadbackCommandNodeProps<Parameters> = {
+  /** Node id, unique within the graph. */
+  id: string;
+  /** Graph buffer (transient or imported) or data view to read. */
+  source: GraphBufferHandle | GraphDataView;
+  /** Start of the copied range, relative to `source`. Defaults to `0`. Multiple of four. */
+  byteOffset?: number;
+  /** Length of the copied range. Defaults to the rest of `source`. Multiple of four. */
+  byteLength?: number;
+  /** Returns the reserved readback ticket that receives the copy, per encoding. */
+  getTicket: (parameters: Parameters) => GPUReadbackTicket;
+  /** Ids of nodes that must be scheduled before this one. */
+  dependsOn?: string[];
+};
+
+/**
+ * Creates a copy-pass node that copies a graph buffer range into a {@link GPUReadbackTicket}.
+ *
+ * Because the copy is a graph node, a transient result can be read at the point of the schedule
+ * where it holds its value, without importing it or extending its lifetime beyond this node. The
+ * application still submits the encoder and calls `ticket.read()`.
+ */
+export function createGPUReadbackCommandNode<Parameters = void>(
+  props: GPUReadbackCommandNodeProps<Parameters>
+): GPUCopyCommandNode<Parameters> {
+  const range = getGraphByteRange(props.source, props.byteOffset, props.byteLength, 'readback');
+  return createGPUCopyCommandNode<Parameters>({
+    id: props.id,
+    dependsOn: props.dependsOn,
+    resources: [{buffer: props.source, usage: 'copy-source'}],
+    compile: () => ({
+      encode: ({commandEncoder, getBuffer, parameters}) => {
+        props.getTicket(parameters).copyFrom(commandEncoder, getBuffer(props.source), {
+          sourceOffset: range.byteOffset,
+          byteLength: range.byteLength
+        });
+      }
+    })
+  });
+}
+
+function getGraphByteRange(
+  buffer: GraphBufferHandle | GraphDataView,
+  byteOffset: number | undefined,
+  byteLength: number | undefined,
+  label: string
+): GraphByteRange {
+  const base =
+    buffer instanceof GraphDataView
+      ? {
+          byteOffset: buffer.byteOffset,
+          byteLength:
+            buffer.length === 0 ? 0 : (buffer.length - 1) * buffer.byteStride + buffer.rowByteLength
+        }
+      : {byteOffset: 0, byteLength: buffer.byteLength};
+  const offset = byteOffset ?? 0;
+  const length = byteLength ?? base.byteLength - offset;
+  if (
+    !Number.isSafeInteger(offset) ||
+    !Number.isSafeInteger(length) ||
+    offset < 0 ||
+    length < 0 ||
+    offset % 4 !== 0 ||
+    length % 4 !== 0 ||
+    offset + length > base.byteLength
+  ) {
+    throw new Error(`${label} byte range must be non-negative, four-byte aligned, and in bounds`);
+  }
+  return {byteOffset: base.byteOffset + offset, byteLength: length};
+}
