{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"scripts/**",
			"tools/**/*.ts",
			"tools/**/*.mjs",
			"tools/**/*.js",
			".vscode/**",
			"index.html",
			"vite.config.ts",
			"examples/**",
			"!examples/**/dist",
			"!src/routeTree.gen.ts",
			"!src/styles.css",
			"!**/node_modules",
			"!**/.venv",
			"!**/out",
			"!**/public",
			"!tools/bench/data*",
			"!tools/bench/final",
			"!tools/matcher/stage1/vendor*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["examples/**"],
			"assist": { "actions": { "source": { "organizeImports": "off" } } },
			"linter": {
				"rules": {
					"recommended": false,
					"correctness": {
						"noUnusedImports": "error",
						"noUnusedVariables": "error"
					},
					"suspicious": { "noDebugger": "error" }
				}
			},
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2,
				"lineWidth": 100
			},
			"javascript": {
				"formatter": {
					"quoteStyle": "single",
					"arrowParentheses": "asNeeded",
					"trailingCommas": "none",
					"bracketSpacing": false,
					"semicolons": "always"
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
